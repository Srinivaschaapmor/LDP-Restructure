{
  "enabledMcpjsonServers": ["figma-dev-mode"],
  "enabledPlugins": { "figma@claude-plugins-official": true },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-write-standards.js",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/check-commit-message.js",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
